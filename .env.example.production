# =============================================================================
# JudgeTracker Atlas - Production Environment Configuration
# =============================================================================
# Production environment: all external ingestion disabled by default,
# strict auth, fail-closed rate limiting.
# =============================================================================

# Application Environment
JTA_APP_ENV=production

# Sample data seeding (disabled in production)
JTA_AUTO_SEED=false

# Database Configuration
# Set this to your production PostgreSQL instance
JTA_DATABASE_URL=postgresql+psycopg://judgetracker:STRONG_PASSWORD_HERE@db-host:5432/judgetracker

# CORS Origins
# Set to your production frontend domain
JTA_CORS_ORIGINS=https://yourdomain.com

# Admin Features (disabled by default in production)
JTA_ENABLE_ADMIN_IMPORTS=false
JTA_ENABLE_ADMIN_REVIEW=false

# Admin tokens (MUST change in production - use strong random values)
JTA_ADMIN_TOKEN=STRONG_RANDOM_TOKEN_REQUIRED
JTA_ADMIN_REVIEW_TOKEN=STRONG_RANDOM_TOKEN_REQUIRED

# Rate limiting
JTA_RATE_LIMIT_ENABLED=true
JTA_RATE_LIMIT_BACKEND=redis
JTA_REDIS_URL=redis://redis:6379/0

# CourtListener (optional)
COURTLISTENER_API_TOKEN=
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com/api
BACKEND_INTERNAL_URL=http://backend:8000
